root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{json,yml,yaml,md}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
csharp_prefer_braces = true:warning
# LoggerMessage delegates are used only where it matters
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA2007.severity = none
# DI-instantiated classes
dotnet_diagnostic.CA1812.severity = none
dotnet_diagnostic.CA1062.severity = none
# public types in tests
dotnet_diagnostic.CA1515.severity = none

# EF Core migrations are generated by `dotnet ef migrations add` (then edited only to append SQL EF cannot model); analyse them as
# generated code so code-style rules written for hand-written files (file-scoped namespaces, etc.) do not fail the build.
[**/Migrations/*.cs]
generated_code = true

# The build-time OpenAPI generator emits JSON without a final newline; preserve its bytes for contract drift checks.
[contracts/openapi/v1.json]
insert_final_newline = false
