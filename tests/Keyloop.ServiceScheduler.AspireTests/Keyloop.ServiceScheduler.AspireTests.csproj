<Project Sdk="Microsoft.NET.Sdk">
  <!-- The whole-stack smoke test (Category=Aspire, Addendum C §C7, SYSTEM_DESIGN §14.3) in a project of its own: Aspire.Hosting runs the
       AppHost in this process and deserialises DCP's answers with reflection-based System.Text.Json, which the integration test process
       turns off on purpose so that it fails exactly where the API would (ADR-016). Nothing here references the API. -->
  <PropertyGroup><OutputType>Exe</OutputType><IsPackable>false</IsPackable><IsTestProject>true</IsTestProject><NoWarn>$(NoWarn);CA1707</NoWarn></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Aspire.Hosting.Testing" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="..\..\src\Keyloop.ServiceScheduler.AppHost\Keyloop.ServiceScheduler.AppHost.csproj" /></ItemGroup>
  <ItemGroup><Using Include="Xunit" /><Using Include="Shouldly" /></ItemGroup>
</Project>
