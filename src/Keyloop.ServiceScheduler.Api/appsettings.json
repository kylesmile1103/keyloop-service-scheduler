{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Scheduling": {
    "VehicleAwareRequirements": false,
    "SlotGranularityMinutes": 15,
    "MinimumLeadTime": "01:00:00",
    "BookingHorizonDays": 90,
    "SuggestedSlotCount": 3
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedDemoData": false
  },
  "Security": {
    "HttpsRedirection": {
      "Enabled": false,
      "HttpsPort": null
    },
    "AllowedOrigins": [],
    "RateLimiting": {
      "Enabled": true,
      "GlobalPermitsPerMinute": 300,
      "BookingPermitsPerMinute": 30
    },
    "ForwardedHeaders": {
      "Enabled": false,
      "KnownProxies": [],
      "KnownNetworks": []
    }
  },
  "Notifications": {
    "Enabled": false,
    "Provider": "None",
    "FromAddress": "notifications@keyloop.example",
    "FromDisplayName": "Keyloop Service Scheduler",
    "ReplyTo": null,
    "IdleInterval": "00:15:00",
    "BatchSize": 10,
    "MaxAttempts": 5,
    "InitialBackoff": "00:00:10",
    "MaxBackoff": "01:00:00",
    "SendTimeout": "00:00:30",
    "ClaimLease": "00:02:00",
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "Encryption": "None"
    }
  }
}
