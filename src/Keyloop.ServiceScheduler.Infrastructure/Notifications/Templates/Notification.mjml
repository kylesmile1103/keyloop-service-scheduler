<mjml lang="en-GB">
  <mj-head>
    <mj-title>{{Heading}}</mj-title>
    <mj-preview>{{PreviewText}}</mj-preview>
    <mj-attributes>
      <mj-all font-family="'Plus Jakarta Sans', 'IBM Plex Sans', 'Segoe UI', Helvetica, Arial, sans-serif" />
      <mj-text font-size="16px" line-height="1.55" color="#1e2e3d" padding="0 32px" />
      <mj-section padding="0" />
      <mj-column padding="0" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#eef2f6" width="640px">
    <mj-section padding="28px 0 18px 0">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#5b6b7a" padding="0 32px">{{PreviewText}}</mj-text>
      </mj-column>
    </mj-section>

    <mj-wrapper background-color="#ffffff" border-radius="16px" padding="0">
      <mj-section background-color="#11181c" border-radius="16px 16px 0 0" padding="26px 32px">
        <mj-column vertical-align="middle">
          <mj-text color="#ffffff" font-size="20px" font-weight="700" letter-spacing="-0.01em" padding="0">
            <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:#0083e0;margin-right:10px;vertical-align:baseline;"></span>Keyloop Service Scheduler
          </mj-text>
          <mj-text color="#a8b6c3" font-size="13px" padding="6px 0 0 0">Workshop booking notice</mj-text>
        </mj-column>
      </mj-section>

      <mj-section padding="30px 0 0 0">
        <mj-column>
          <mj-text padding="0 32px 14px 32px">
            <span style="display:inline-block;padding:6px 14px;border-radius:999px;background:{{StatusBg}};color:{{StatusFg}};font-size:13px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;">{{StatusLabel}}</span>
          </mj-text>
          <mj-text padding="0 32px 10px 32px"><h1 style="margin:0;font-size:28px;line-height:1.2;font-weight:700;color:#11181c;letter-spacing:-0.015em;">{{Heading}}</h1></mj-text>
          <mj-text padding="0 32px 24px 32px" color="#3d4f60">{{Introduction}}</mj-text>
        </mj-column>
      </mj-section>

      <mj-section padding="0 32px 8px 32px">
        <mj-column background-color="#f6f8fa" border-radius="12px" padding="18px 22px" border="1px solid #e6ebf0">
          <mj-text font-size="13px" color="#5b6b7a" letter-spacing="0.04em" text-transform="uppercase" padding="0 0 4px 0">Service</mj-text>
          <mj-text font-size="22px" font-weight="700" color="#11181c" padding="0 0 14px 0">{{Service}}</mj-text>
          <mj-text padding="0">
            <dl style="margin:0;padding:0;">
              <dt style="margin:0;padding:10px 0 2px 0;border-top:1px solid #e6ebf0;color:#5b6b7a;font-size:13px;letter-spacing:0.04em;text-transform:uppercase;">Starts</dt>
              <dd style="margin:0 0 8px 0;padding:0;color:#1e2e3d;font-size:16px;font-weight:600;">{{Start}}</dd>
              <dt style="margin:0;padding:10px 0 2px 0;border-top:1px solid #e6ebf0;color:#5b6b7a;font-size:13px;letter-spacing:0.04em;text-transform:uppercase;">Ends</dt>
              <dd style="margin:0 0 8px 0;padding:0;color:#1e2e3d;font-size:16px;font-weight:600;">{{End}}</dd>
              <dt style="margin:0;padding:10px 0 2px 0;border-top:1px solid #e6ebf0;color:#5b6b7a;font-size:13px;letter-spacing:0.04em;text-transform:uppercase;">Dealership</dt>
              <dd style="margin:0 0 8px 0;padding:0;color:#1e2e3d;font-size:16px;font-weight:600;">{{Dealership}}</dd>
              <dt style="margin:0;padding:10px 0 2px 0;border-top:1px solid #e6ebf0;color:#5b6b7a;font-size:13px;letter-spacing:0.04em;text-transform:uppercase;">Vehicle registration</dt>
              <dd style="margin:0 0 8px 0;padding:0;color:#1e2e3d;font-size:16px;font-weight:600;">{{Registration}}</dd>
              <dt style="margin:0;padding:10px 0 2px 0;border-top:1px solid #e6ebf0;color:#5b6b7a;font-size:13px;letter-spacing:0.04em;text-transform:uppercase;">VIN</dt>
              <dd style="margin:0;padding:0;color:#1e2e3d;font-size:16px;font-weight:600;">{{Vin}}</dd>
            </dl>
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section padding="18px 32px 6px 32px">
        <mj-column width="50%" padding="0 8px 0 0">
          <mj-text font-size="13px" color="#5b6b7a" letter-spacing="0.04em" text-transform="uppercase" padding="0 0 4px 0">Booking reference</mj-text>
          <!-- The face goes on the element itself: mj-all's inline font-family on the inner div would beat a class on the outer cell. -->
          <mj-text font-family="'IBM Plex Mono', 'SFMono-Regular', Menlo, Consolas, monospace" letter-spacing="0.08em" font-size="26px" font-weight="700" color="#0083e0" padding="0 0 16px 0">{{Reference}}</mj-text>
        </mj-column>
        <mj-column width="50%" padding="0 0 0 8px">
          <mj-text font-size="13px" color="#5b6b7a" letter-spacing="0.04em" text-transform="uppercase" padding="0 0 4px 0">Quote it when you call</mj-text>
          <mj-text font-size="15px" color="#3d4f60" padding="0 0 16px 0">{{Support}}</mj-text>
        </mj-column>
      </mj-section>

      <mj-section padding="0 32px 28px 32px">
        <mj-column>
          <mj-divider border-width="1px" border-color="#e6ebf0" padding="0 0 16px 0" />
          <mj-text font-size="12px" color="#8a98a6" line-height="1.5" padding="0">
            Full appointment id <span style="font-family:'IBM Plex Mono', 'SFMono-Regular', Menlo, Consolas, monospace;letter-spacing:0.08em;">{{AppointmentId}}</span>. This is an automatic message about a workshop booking for this vehicle; replies are not monitored.
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-section padding="22px 0 32px 0">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#8a98a6" padding="0 32px">Keyloop Service Scheduler is a technical assessment demo. Booking data in it is fictitious.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
